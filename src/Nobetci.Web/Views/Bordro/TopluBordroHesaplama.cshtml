@{
    ViewData["Title"] = "Toplu Bordro Hesaplama";
    var isTurkish = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "tr";
    var donemler = ViewBag.UygunDonemler as IEnumerable<object> ?? new List<object>();
}

<div class="container" style="max-width:900px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">@(isTurkish ? "Toplu Bordro Hesaplama" : "Bulk Payroll Calculation")</h2>
            <div class="text-muted" style="font-size:0.9rem;">
                @(isTurkish ? "Dönem seçip toplu bordro hesaplayın." : "Select a period and calculate payroll in bulk.")
            </div>
        </div>
        <a class="btn btn-outline-secondary" href="/App/Payroll">
            @(isTurkish ? "Bordroya Dön" : "Back to Payroll")
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <form id="topluForm" class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@(isTurkish ? "Dönem" : "Period")</label>
                    <select class="form-select" id="donemSelect" required>
                        @foreach (var item in donemler)
                        {
                            var yil = (int)item.GetType().GetProperty("Yil")!.GetValue(item)!;
                            var ay = (int)item.GetType().GetProperty("Ay")!.GetValue(item)!;
                            var text = item.GetType().GetProperty("DonemText")!.GetValue(item)!.ToString();
                            <option value="@yil-@ay">@text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="yenidenHesapla">
                        <label class="form-check-label">@(isTurkish ? "Yeniden Hesapla" : "Recalculate")</label>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" type="submit">
                        @(isTurkish ? "Başlat" : "Start")
                    </button>
                </div>
            </form>
            <div id="topluResult" class="mt-3"></div>
        </div>
    </div>
</div>

<script>
    const isTurkish = @isTurkish.ToString().ToLower();
    document.getElementById('topluForm')?.addEventListener('submit', async function (e) {
        e.preventDefault();
        const val = document.getElementById('donemSelect')?.value || '';
        const parts = val.split('-');
        const yil = parseInt(parts[0] || '0');
        const ay = parseInt(parts[1] || '0');
        const yeniden = document.getElementById('yenidenHesapla')?.checked || false;

        const res = await fetch('/Bordro/TopluBordroHesaplamaBaslat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ yil, ay, yenidenHesapla: yeniden })
        });
        const data = await res.json();
        const el = document.getElementById('topluResult');
        if (data.success) {
            el.innerHTML = `<div class="alert alert-success">${data.message}</div>`;
        } else {
            el.innerHTML = `<div class="alert alert-danger">${data.message || (isTurkish ? 'Hata oluştu' : 'Error occurred')}</div>`;
        }
    });
</script>
