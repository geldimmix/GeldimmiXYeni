@{
    ViewData["Title"] = "Personel Puan Import";
    var isTurkish = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "tr";
}

<div class="container" style="max-width:900px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">@(isTurkish ? "Personel Puan Import" : "Personnel Score Import")</h2>
            <div class="text-muted" style="font-size:0.9rem;">
                @(isTurkish ? "Excel dosyası ile personel puanlarını toplu yükleyin." : "Upload personnel scores via Excel.")
            </div>
        </div>
        <a class="btn btn-outline-secondary" href="/App/Payroll">
            @(isTurkish ? "Bordroya Dön" : "Back to Payroll")
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <form id="importForm" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">@(isTurkish ? "Excel Dosyası" : "Excel File")</label>
                    <input type="file" class="form-control" name="excelFile" accept=".xlsx,.xls" required />
                </div>
                <button class="btn btn-primary" type="submit">@(isTurkish ? "Yükle" : "Upload")</button>
            </form>
            <div id="importResult" class="mt-3"></div>
        </div>
    </div>
</div>

<script>
    const isTurkish = @isTurkish.ToString().ToLower();
    document.getElementById('importForm')?.addEventListener('submit', async function (e) {
        e.preventDefault();
        const formData = new FormData(this);
        const res = await fetch('/Bordro/PersonelPuanImportExcel', {
            method: 'POST',
            body: formData
        });
        const data = await res.json();
        const el = document.getElementById('importResult');
        if (data.success) {
            el.innerHTML = `<div class="alert alert-success">${data.message}</div>`;
        } else {
            el.innerHTML = `<div class="alert alert-danger">${data.message || (isTurkish ? 'Hata oluştu' : 'Error occurred')}</div>`;
        }
    });
</script>
