@model List<Nobetci.Web.Data.Entities.BordroYetkileri>
@{
    ViewData["Title"] = "Bordro Yetkileri";
    var isTurkish = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "tr";
    var units = ViewBag.Units as List<Nobetci.Web.Data.Entities.Unit> ?? new();
    var lookup = ViewBag.EmployeeLookup as Dictionary<string, object> ?? new();
}

<div class="container" style="max-width:1200px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">@(isTurkish ? "Bordro Yetkileri" : "Payroll Permissions")</h2>
            <div class="text-muted" style="font-size:0.9rem;">
                @(isTurkish ? "Birim bazlı bordro yetkilerini yönetin." : "Manage unit-based payroll permissions.")
            </div>
        </div>
        <a class="btn btn-outline-secondary" href="/App/Payroll">
            @(isTurkish ? "Bordroya Dön" : "Back to Payroll")
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">@(isTurkish ? "Yetki Ekle" : "Add Permission")</div>
        <div class="card-body">
            <form id="yetkiForm" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">@(isTurkish ? "Birim" : "Unit")</label>
                    <select class="form-select" name="unitId" required>
                        <option value="">@(isTurkish ? "Seçiniz" : "Select")</option>
                        @foreach (var unit in units)
                        {
                            <option value="@unit.Id">@unit.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@(isTurkish ? "TC Kimlik" : "Identity No")</label>
                    <input class="form-control" name="tcKimlik" maxlength="20" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@(isTurkish ? "Kadro Tipi" : "Cadre Type")</label>
                    <select class="form-select" name="kadroTipiYetkisi">
                        <option value="4A">4A</option>
                        <option value="4B">4B</option>
                        <option value="GENEL">GENEL</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary" type="submit">@(isTurkish ? "Ekle" : "Add")</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-semibold">@(isTurkish ? "Mevcut Yetkiler" : "Current Permissions")</div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@(isTurkish ? "Birim" : "Unit")</th>
                        <th>@(isTurkish ? "TC" : "ID")</th>
                        <th>@(isTurkish ? "Kadro" : "Cadre")</th>
                        <th>@(isTurkish ? "İşlem" : "Action")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Unit?.Name</td>
                            <td>@item.TcKimlik</td>
                            <td>@(string.IsNullOrEmpty(item.KadroTipiYetkisi) ? "GENEL" : item.KadroTipiYetkisi)</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" onclick="removeYetki(@item.Id)">
                                    @(isTurkish ? "Sil" : "Remove")
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                @(isTurkish ? "Henüz yetki yok." : "No permissions yet.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    const isTurkish = @isTurkish.ToString().ToLower();
    document.getElementById('yetkiForm')?.addEventListener('submit', async function (e) {
        e.preventDefault();
        const formData = new FormData(this);
        const payload = new URLSearchParams(formData);
        const res = await fetch('/Bordro/YetkiliEkle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: payload
        });
        const data = await res.json();
        alert(data.message || (isTurkish ? 'Tamamlandı' : 'Done'));
        if (data.success) location.reload();
    });

    async function removeYetki(id) {
        const res = await fetch('/Bordro/YetkiliSil', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ id })
        });
        const data = await res.json();
        alert(data.message || (isTurkish ? 'Tamamlandı' : 'Done'));
        if (data.success) location.reload();
    }
</script>
