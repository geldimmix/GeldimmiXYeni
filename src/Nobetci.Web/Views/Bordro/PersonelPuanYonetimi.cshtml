@model Nobetci.Web.Models.PersonelPuanYonetimViewModel
@{
    ViewData["Title"] = "Personel Puan Yönetimi";
    var isTurkish = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "tr";
    var isEditing = Model.NewPersonel.Id.HasValue;
}

<div class="container" style="max-width:1100px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">@(isTurkish ? "Personel Puan Yönetimi" : "Personnel Score Management")</h2>
            <div class="text-muted" style="font-size:0.9rem;">
                @(isTurkish ? "Nöbet puanı ve saat ücretlerini yönetin." : "Manage duty scores and hourly rates.")
            </div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="/Bordro/PersonelPuanImport">
                @(isTurkish ? "Excel Import" : "Excel Import")
            </a>
            <a class="btn btn-outline-secondary" href="/App/Payroll">
                @(isTurkish ? "Bordroya Dön" : "Back to Payroll")
            </a>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <form asp-action="PersonelPuanKaydet" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="NewPersonel.Id" />
                <div class="col-md-3">
                    <label class="form-label">TC Kimlik</label>
                    <input class="form-control" asp-for="NewPersonel.TcKimlik" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label">@(isTurkish ? "Ad Soyad" : "Full Name")</label>
                    <input class="form-control" asp-for="NewPersonel.AdiSoyadi" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@(isTurkish ? "Unvan" : "Title")</label>
                    <input class="form-control" asp-for="NewPersonel.Unvan" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@(isTurkish ? "Mezuniyet" : "Education")</label>
                    <select class="form-select" asp-for="NewPersonel.Mezuniyet">
                        <option value="">@(isTurkish ? "Seçiniz" : "Select")</option>
                        <option>SH Dışı</option>
                        <option>Vhki</option>
                        <option>Diğer</option>
                        <option>Ortaöğretim</option>
                        <option>Önlisans</option>
                        <option>Lisans</option>
                        <option>Yüksek Lisans</option>
                        <option>Doktora</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@(isTurkish ? "Y Puan" : "Score")</label>
                    <input class="form-control" asp-for="NewPersonel.YPuan" type="number" min="0" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@(isTurkish ? "Normal Saat Ücreti" : "Normal Rate")</label>
                    <input class="form-control" asp-for="NewPersonel.NormalSaatUcreti" type="number" step="0.01" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@(isTurkish ? "Yoğun Bakım Ücreti" : "ICU Rate")</label>
                    <input class="form-control" asp-for="NewPersonel.YogunBakimSaatUcreti" type="number" step="0.01" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@(isTurkish ? "İcap Ücreti" : "On-Call Rate")</label>
                    <input class="form-control" asp-for="NewPersonel.IcapSaatUcreti" type="number" step="0.01" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">IBAN</label>
                    <input class="form-control" asp-for="NewPersonel.Iban" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@(isTurkish ? "Önceki Soyadı" : "Previous Surname")</label>
                    <input class="form-control" asp-for="NewPersonel.OncekiSoyadi" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@(isTurkish ? "Açıklama" : "Description")</label>
                    <input class="form-control" asp-for="NewPersonel.Description" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="NewPersonel.IsActive" />
                        <label class="form-check-label">@(isTurkish ? "Aktif" : "Active")</label>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" type="submit">
                        @(isEditing ? (isTurkish ? "Güncelle" : "Update") : (isTurkish ? "Ekle" : "Add"))
                    </button>
                </div>
                @if (isEditing)
                {
                    <div class="col-md-2 d-flex align-items-end">
                        <a class="btn btn-outline-secondary w-100" href="/Bordro/PersonelPuanYonetimi">
                            @(isTurkish ? "Yeni Kayıt" : "New Entry")
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>TC</th>
                            <th>@(isTurkish ? "Ad Soyad" : "Full Name")</th>
                            <th>@(isTurkish ? "Unvan" : "Title")</th>
                            <th>@(isTurkish ? "Y Puan" : "Score")</th>
                            <th>@(isTurkish ? "Normal" : "Normal")</th>
                            <th>@(isTurkish ? "Yoğun" : "ICU")</th>
                            <th>@(isTurkish ? "İcap" : "On-Call")</th>
                            <th>@(isTurkish ? "Durum" : "Status")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Personeller)
                        {
                            <tr>
                                <td>@p.TcKimlik</td>
                                <td>@p.AdiSoyadi</td>
                                <td>@p.Unvan</td>
                                <td>@p.YPuan</td>
                                <td>@p.NormalSaatUcreti.ToString("0.##")</td>
                                <td>@p.YogunBakimSaatUcreti.ToString("0.##")</td>
                                <td>@p.IcapSaatUcreti.ToString("0.##")</td>
                                <td>
                                    <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">
                                        @(p.IsActive ? (isTurkish ? "Aktif" : "Active") : (isTurkish ? "Pasif" : "Inactive"))
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" href="/Bordro/PersonelPuanYonetimi?editId=@p.Id">
                                        @(isTurkish ? "Düzenle" : "Edit")
                                    </a>
                                    <form asp-action="PersonelPuanPasiflestir" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">
                                            @(isTurkish ? "Pasif" : "Disable")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
