@model Nobetci.Web.Models.PuantajDetailViewModel
@{
    ViewData["Title"] = "Puantaj Detay";
    var isTurkish = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "tr";
}

<div class="container" style="max-width:1200px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">@Model.Employee.FullName</h2>
            <div class="text-muted" style="font-size:0.9rem;">
                @Model.MonthName • @(string.IsNullOrEmpty(Model.Employee.Title) ? "" : Model.Employee.Title)
            </div>
        </div>
        <a class="btn btn-outline-secondary" href="/App/Payroll?year=@Model.Year&month=@Model.Month">
            @(isTurkish ? "Bordroya Dön" : "Back to Payroll")
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card p-3">
                <div class="text-muted" style="font-size:0.75rem;">@(isTurkish ? "Toplam Saat" : "Total Hours")</div>
                <div class="fw-semibold">@Model.Payroll.TotalWorkedHours.ToString("0.##")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <div class="text-muted" style="font-size:0.75rem;">@(isTurkish ? "Fazla Mesai" : "Overtime")</div>
                <div class="fw-semibold">@Model.Payroll.OvertimeHours.ToString("0.##")</div>
                <div class="text-muted" style="font-size:0.75rem;">
                    @(isTurkish ? "Normal" : "Normal"): @Model.Payroll.NormalOvertimeHours.ToString("0.##") •
                    @(isTurkish ? "Yoğun" : "ICU"): @Model.Payroll.IntensiveOvertimeHours.ToString("0.##")
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <div class="text-muted" style="font-size:0.75rem;">@(isTurkish ? "Tatil Saatleri" : "Holiday Hours")</div>
                <div class="fw-semibold">@Model.Payroll.HolidayHours.ToString("0.##")</div>
                <div class="text-muted" style="font-size:0.75rem;">
                    @(isTurkish ? "Normal" : "Normal"): @Model.Payroll.NormalHolidayHours.ToString("0.##") •
                    @(isTurkish ? "Yoğun" : "ICU"): @Model.Payroll.IntensiveHolidayHours.ToString("0.##")
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <div class="text-muted" style="font-size:0.75rem;">@(isTurkish ? "Bayram Farkı" : "Holiday Diff")</div>
                <div class="fw-semibold">@Model.Payroll.HolidayDifferenceHours.ToString("0.##")</div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-semibold">
            @(isTurkish ? "Günlük Detay" : "Daily Detail")
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@(isTurkish ? "Tarih" : "Date")</th>
                        <th>@(isTurkish ? "Giriş" : "In")</th>
                        <th>@(isTurkish ? "Çıkış" : "Out")</th>
                        <th class="text-end">@(isTurkish ? "Saat" : "Hours")</th>
                        <th class="text-end">@(isTurkish ? "Gece" : "Night")</th>
                        <th class="text-end">@(isTurkish ? "H.Sonu" : "Wknd")</th>
                        <th class="text-end">@(isTurkish ? "Tatil" : "Holiday")</th>
                        <th>@(isTurkish ? "Tip" : "Type")</th>
                        <th>@(isTurkish ? "Durum" : "Status")</th>
                        <th>@(isTurkish ? "Not" : "Note")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.Payroll.ShiftDetails.OrderBy(d => d.Date))
                    {
                        var status = detail.IsLeave
                            ? (isTurkish ? "İzin" : "Leave")
                            : (detail.IsDayOff ? (isTurkish ? "Boş" : "Off") : "");
                        <tr>
                            <td>@detail.Date.ToString("dd.MM.yyyy")</td>
                            <td>@(detail.StartTime?.ToString("HH:mm") ?? "-")</td>
                            <td>@(detail.EndTime?.ToString("HH:mm") ?? "-")</td>
                            <td class="text-end">@detail.TotalHours.ToString("0.##")</td>
                            <td class="text-end">@detail.NightHours.ToString("0.##")</td>
                            <td class="text-end">@detail.WeekendHours.ToString("0.##")</td>
                            <td class="text-end">@detail.HolidayHours.ToString("0.##")</td>
                            <td>@(detail.IsIntensiveCare ? (isTurkish ? "Yoğun" : "ICU") : (isTurkish ? "Normal" : "Normal"))</td>
                            <td>@status</td>
                            <td>@(detail.Note ?? detail.HolidayName ?? "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
